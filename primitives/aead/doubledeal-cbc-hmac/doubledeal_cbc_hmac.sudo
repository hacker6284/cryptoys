// DoubleDeal-CBC-Sandwich v2 (proposed name; directory and file keep the v1 name
// doubledeal-cbc-hmac for now). The rules are primitives/aead/doubledeal-cbc-hmac/SPEC.md.
// Toy Encrypt-then-MAC on decks: deck-CBC (Compose with the previous ciphertext deck),
// then a Sandwich MAC on one MegaDreifach megaminx. Not for real use. No XOR anywhere.
// Frozen v1 (DoubleDeal-CBC-HMAC v1): v1/doubledeal_cbc_hmac.sudo.
// New loops are bounded for. emit-ir --require terminates must pass.

import megadreifach
import doubledeal

msg_block = 28
wire_block = 29
tag_len = 29

enc_label = "DoubleDeal-CBC-Sandwich/v2/enc"
mac_label = "DoubleDeal-CBC-Sandwich/v2/mac"

// ---------------------------------------------------------------- checks

func require_bytes(xs: List<int>)
    for i = 0 to xs.length - 1
        assert (xs[i] >= 0) and (xs[i] <= 255)

func is_deck(d: List<int>) -> bool
    if d.length != 52
        return false
    seen = filled(52, 0)
    ok = true
    for i = 0 to 51
        c = d[i]
        if (c < 0) or (c > 51)
            ok = false
        else if seen[c] == 1
            ok = false
        else
            seen[c] = 1
    return ok

func require_deck(d: List<int>)
    assert is_deck(d)

func same_list(a: List<int>, b: List<int>) -> bool
    if a.length != b.length
        return false
    diff = 0
    for i = 0 to a.length - 1
        if a[i] != b[i]
            diff = diff + 1
    return diff == 0

// ---------------------------------------------------------------- the fixed decks

// New-deck (CHaSeD) order: A of clubs on top, ..., K of diamonds at the bottom.
func sorted_deck() -> List<int>
    out: List<int> = []
    for i = 0 to 51
        out.append(i)
    return out

// A deck turned over: the old bottom card is now on top.
func turned_over(d: List<int>) -> List<int>
    out: List<int> = []
    for i = 0 to d.length - 1
        out.append(d[d.length - 1 - i])
    return out

// v2: a sorted deck with its top two cards swapped (2 of clubs on top, then A of clubs).
export func version_deck() -> List<int>
    d = sorted_deck()
    d[0] = 1
    d[1] = 0
    return d

// ---------------------------------------------------------------- Compose (DoubleDeal SPEC 3.6)

func index_of(deck: List<int>, card: int) -> int
    for i = 0 to 51
        if deck[i] == card
            return i
    assert false
    return 0

// Compose(M, K)[j] = M[K.index(j)]: PLACE M through K.
func compose(m: List<int>, k: List<int>) -> List<int>
    out: List<int> = []
    for j = 0 to 51
        out.append(m[index_of(k, j)])
    return out

// InverseCompose(C, K)[K.index(j)] = C[j]: COLLECT C through K.
func inverse_compose(c: List<int>, k: List<int>) -> List<int>
    out = filled(52, 0)
    for j = 0 to 51
        out[index_of(k, j)] = c[j]
    return out

// ---------------------------------------------------------------- software edge: big integers
// Unsigned integers as fixed-width big-endian byte lists. Only the byte <-> deck edge, the
// optional key derivation and the wire format use them. No XOR.

func bn_mul_small_add(n: List<int>, m: int, add: int) -> List<int>
    assert (m >= 0) and (m <= 256) and (add >= 0) and (add <= 256)
    out = filled(n.length, 0)
    carry = add
    for i = n.length - 1 downto 0
        cur = n[i] * m + carry
        out[i] = cur mod 256
        carry = cur / 256
    assert carry == 0
    return out

func bn_divmod_small(n: List<int>, d: int) -> (List<int>, int)
    assert (d > 0) and (d <= 256)
    q = filled(n.length, 0)
    rem = 0
    for i = 0 to n.length - 1
        cur = rem * 256 + n[i]
        q[i] = cur / d
        rem = cur mod d
    return (q, rem)

func bn_is_zero(n: List<int>) -> bool
    nonzero = 0
    for i = 0 to n.length - 1
        if n[i] != 0
            nonzero = nonzero + 1
    return nonzero == 0

func bn_add(a: List<int>, b: List<int>) -> List<int>
    assert a.length == b.length
    out = filled(a.length, 0)
    carry = 0
    for i = a.length - 1 downto 0
        cur = a[i] + b[i] + carry
        out[i] = cur mod 256
        carry = cur / 256
    assert carry == 0
    return out

// Full product, width a.length + b.length.
func bn_mul(a: List<int>, b: List<int>) -> List<int>
    out = filled(a.length + b.length, 0)
    for i = a.length - 1 downto 0
        carry = 0
        for j = b.length - 1 downto 0
            pos = i + j + 1
            cur = out[pos] + a[i] * b[j] + carry
            out[pos] = cur mod 256
            carry = cur / 256
        out[i] = carry
    return out

func bn_widen(n: List<int>, width: int) -> List<int>
    assert width >= n.length
    out = filled(width - n.length, 0)
    for i = 0 to n.length - 1
        out.append(n[i])
    return out

// |G| = (20!/2)(30!/2) 3^19 2^29, the megaminx group order (MegaDreifach v3 SPEC section 4):
// every MegaDreifach digest, read big-endian, is below it.
func group_order() -> List<int>
    n = filled(wire_block, 0)
    n[wire_block - 1] = 1
    for f = 3 to 20
        n = bn_mul_small_add(n, f, 0)
    for f = 3 to 30
        n = bn_mul_small_add(n, f, 0)
    for i = 1 to 19
        n = bn_mul_small_add(n, 3, 0)
    for i = 1 to 29
        n = bn_mul_small_add(n, 2, 0)
    return n

// ---------------------------------------------------------------- software edge: bytes <-> decks
// The factoradic of DoubleDeal SPEC 5.3: deck -> rank = sum of d_k (51 - k)!, where d_k is the
// position of card k among the cards not yet used, in new-deck order.

func pop_at(items: List<int>, idx: int) -> (int, List<int>)
    rest: List<int> = []
    for i = 0 to items.length - 1
        if i != idx
            rest.append(items[i])
    return (items[idx], rest)

// Lehmer digits (d_0 .. d_51) of n mod 52!, least significant first; also the final quotient
// floor(n / 52!).
func lehmer_of(n: List<int>) -> (List<int>, List<int>)
    digits = filled(52, 0)
    q = n
    for r = 1 to 52
        q, d = bn_divmod_small(q, r)
        digits[52 - r] = d
    return (digits, q)

func deck_of_digits(digits: List<int>) -> List<int>
    items = sorted_deck()
    out: List<int> = []
    for k = 0 to 51
        c, rest = pop_at(items, digits[k])
        out.append(c)
        items = rest
    return out

// unrank(n mod 52!) for any big-endian n.
func unrank_reduce(n: List<int>) -> List<int>
    digits, q = lehmer_of(n)
    return deck_of_digits(digits)

// The 29-byte big-endian rank of a deck (always below 52!).
func rank29(d: List<int>) -> List<int>
    require_deck(d)
    items = sorted_deck()
    n = filled(wire_block, 0)
    for k = 0 to 51
        idx = index_of_list(items, d[k])
        n = bn_mul_small_add(n, 52 - k, idx)
        c, rest = pop_at(items, idx)
        items = rest
    return n

func index_of_list(items: List<int>, card: int) -> int
    for i = 0 to items.length - 1
        if items[i] == card
            return i
    assert false
    return 0

// A 29-byte wire number -> (is it below 52!, the deck it names).
func wire_to_deck(w: List<int>) -> (bool, List<int>)
    assert w.length == wire_block
    digits, q = lehmer_of(w)
    return (bn_is_zero(q), deck_of_digits(digits))

// A 28-byte block -> its deck (every 28-byte value is below 2^224 < 52!).
func block_to_deck(b: List<int>) -> List<int>
    assert b.length == msg_block
    return unrank_reduce(b)

// A deck -> (is its rank below 2^224, the 28 low bytes of the rank).
func deck_to_block(d: List<int>) -> (bool, List<int>)
    r = rank29(d)
    out: List<int> = []
    for i = 1 to wire_block - 1
        out.append(r[i])
    return (r[0] == 0, out)

// ---------------------------------------------------------------- pad (DoubleDeal ECB pad)

export func pad_iso7816(msg: List<int>) -> List<int>
    require_bytes(msg)
    out = msg + [128]
    nzero = (msg_block - (out.length mod msg_block)) mod msg_block
    for i = 1 to nzero
        out.append(0)
    assert out.length mod msg_block == 0
    return out

// (ok, message): ok only if the stream is non-empty, a multiple of 28 bytes, and ends in
// 0x80 followed only by 0x00 with the marker in the last block. Never traps.
func unpad_checked(msg: List<int>) -> (bool, List<int>)
    empty: List<int> = []
    if (msg.length == 0) or (msg.length mod msg_block != 0)
        return (false, empty)
    marker = 0 - 1
    for n = 0 to msg.length - 1
        i = msg.length - 1 - n
        if (marker < 0) and (msg[i] != 0)
            marker = i
    if marker < msg.length - msg_block
        return (false, empty)
    if msg[marker] != 128
        return (false, empty)
    out: List<int> = []
    for j = 0 to marker - 1
        out.append(msg[j])
    return (true, out)

// ---------------------------------------------------------------- the MAC input (decks)

// AAD is bytes (software-only interface): zero-filled to a multiple of 28, each 28-byte chunk
// becomes a deck; no decks for empty AAD. The length deck at the end makes it unambiguous.
func aad_decks(aad: List<int>) -> List<List<int>>
    require_bytes(aad)
    out: List<List<int>> = []
    nblocks = (aad.length + msg_block - 1) / msg_block
    for b = 0 to nblocks - 1
        chunk: List<int> = []
        for j = 0 to msg_block - 1
            i = b * msg_block + j
            if i < aad.length
                chunk.append(aad[i])
            else
                chunk.append(0)
        out.append(block_to_deck(chunk))
    return out

// unrank(n) for 0 <= n: the AAD length in bytes (a sorted deck when there is no AAD).
func length_deck(n: int) -> List<int>
    assert n >= 0
    w = filled(8, 0)
    rest = n
    for i = 7 downto 0
        w[i] = rest mod 256
        rest = rest / 256
    return unrank_reduce(w)

// S = version deck || AAD decks || IV || C_0 .. C_{n-1} || length deck (SPEC section 5.1).
export func mac_decks(aad: List<int>, iv: List<int>, cdecks: List<List<int>>) -> List<List<int>>
    require_deck(iv)
    assert cdecks.length > 0
    out: List<List<int>> = []
    out.append(version_deck())
    extra = aad_decks(aad)
    for i = 0 to extra.length - 1
        out.append(extra[i])
    out.append(iv)
    for i = 0 to cdecks.length - 1
        require_deck(cdecks[i])
        out.append(cdecks[i])
    out.append(length_deck(aad.length))
    return out

// ---------------------------------------------------------------- the MAC (one function)

// The same physical cards in MegaDreifach's numbering (4 rank + suit; DoubleDeal is 13 suit + rank).
func md_ids(d: List<int>) -> List<int>
    out: List<int> = []
    for i = 0 to 51
        out.append(4 * (d[i] mod 13) + d[i] / 13)
    return out

// Sandwich MAC on one megaminx: from IV-COOK12 absorb the key deck as it lies, then every
// deck of S, then the key deck turned over. The tag is the finished position (29-byte rank).
export func mac_tag(k_mac: List<int>, decks: List<List<int>>) -> List<int>
    require_deck(k_mac)
    assert decks.length > 0
    seq: List<List<int>> = []
    seq.append(md_ids(k_mac))
    for i = 0 to decks.length - 1
        require_deck(decks[i])
        seq.append(md_ids(decks[i]))
    seq.append(md_ids(turned_over(k_mac)))
    tag = megadreifach.HashDecksBody(seq)
    assert tag.length == tag_len
    return tag

// ---------------------------------------------------------------- optional key derivation

func u16be(n: int) -> List<int>
    assert (n >= 0) and (n <= 65535)
    return [n / 256, n mod 256]

func u64be(n: int) -> List<int>
    assert n >= 0
    out = filled(8, 0)
    rest = n
    for i = 7 downto 0
        out[i] = rest mod 256
        rest = rest / 256
    assert rest == 0
    return out

func kdf_digest(label: List<int>, j: int, master: List<int>) -> List<int>
    return megadreifach.Hash(u16be(label.length) + label + [j] + u64be(master.length) + master)

// unrank((d_a |G| + d_b) mod 52!): statistical distance about 2^-228.27 from a uniform deck
// if the digests are uniform (heuristic).
func kdf_deck(label: List<int>, j: int, master: List<int>) -> List<int>
    da = kdf_digest(label, j, master)
    db = kdf_digest(label, j + 1, master)
    x = bn_add(bn_mul(da, group_order()), bn_widen(db, 2 * wire_block))
    return unrank_reduce(x)

// OPTIONAL: derive the two key decks from a byte master secret. Keys are normally user
// supplied decks (truly shuffled); security assumes uniformly random key decks however made.
export func derive_key_decks(master: List<int>) -> (List<int>, List<int>)
    require_bytes(master)
    assert master.length > 0
    return (kdf_deck(enc_label, 0, master), kdf_deck(mac_label, 2, master))

// ---------------------------------------------------------------- the AEAD

func check_keys(k_enc: List<int>, k_mac: List<int>)
    require_deck(k_enc)
    require_deck(k_mac)
    assert not same_list(k_enc, k_mac)

// Encrypt. iv MUST be a freshly and truly shuffled full deck (the host draws it; sudo has no
// randomness). Returns rank29(IV) || rank29(C_0) .. rank29(C_{n-1}) || tag.
export func aead_seal(plaintext: List<int>, k_enc: List<int>, k_mac: List<int>, aad: List<int>, iv: List<int>) -> List<int>
    require_bytes(plaintext)
    require_bytes(aad)
    check_keys(k_enc, k_mac)
    require_deck(iv)
    padded = pad_iso7816(plaintext)
    chain = iv
    cdecks: List<List<int>> = []
    for b = 0 to padded.length / msg_block - 1
        block: List<int> = []
        for j = 0 to msg_block - 1
            block.append(padded[b * msg_block + j])
        chain = doubledeal.encrypt(compose(block_to_deck(block), chain), k_enc)
        cdecks.append(chain)
    tag = mac_tag(k_mac, mac_decks(aad, iv, cdecks))
    out = rank29(iv)
    for i = 0 to cdecks.length - 1
        out = out + rank29(cdecks[i])
    return out + tag

// Decrypt. Returns (true, plaintext) or (false, []) for every failure alike. Order: public
// parse (no key), then the tag over the decks, and only then DoubleDeal.decrypt.
export func aead_open(blob: List<int>, k_enc: List<int>, k_mac: List<int>, aad: List<int>) -> (bool, List<int>)
    require_bytes(blob)
    require_bytes(aad)
    check_keys(k_enc, k_mac)
    empty: List<int> = []
    if (blob.length < 3 * wire_block) or (blob.length mod wire_block != 0)
        return (false, empty)
    nwire = blob.length / wire_block - 1
    decks: List<List<int>> = []
    for w = 0 to nwire - 1
        chunk: List<int> = []
        for j = 0 to wire_block - 1
            chunk.append(blob[w * wire_block + j])
        ok, d = wire_to_deck(chunk)
        if not ok
            return (false, empty)
        decks.append(d)
    tag: List<int> = []
    for j = 0 to tag_len - 1
        tag.append(blob[nwire * wire_block + j])
    iv = decks[0]
    cdecks: List<List<int>> = []
    for i = 1 to nwire - 1
        cdecks.append(decks[i])
    if not same_list(tag, mac_tag(k_mac, mac_decks(aad, iv, cdecks)))
        return (false, empty)
    chain = iv
    padded: List<int> = []
    for i = 0 to cdecks.length - 1
        ok, block = deck_to_block(inverse_compose(doubledeal.decrypt(cdecks[i], k_enc), chain))
        if not ok
            return (false, empty)
        padded = padded + block
        chain = cdecks[i]
    return unpad_checked(padded)

// ---------------------------------------------------------------- tests

func some_deck(step: int) -> List<int>
    out: List<int> = []
    for i = 0 to 51
        out.append((i * step + 5) mod 52)
    return out

test "PLACE through a sorted deck keeps a deck; through a turned-over deck reverses it"
    k = some_deck(7)
    assert compose(k, sorted_deck()) == k
    assert compose(k, turned_over(sorted_deck())) == turned_over(k)
    c = some_deck(11)
    assert inverse_compose(compose(k, c), c) == k
    assert compose(inverse_compose(k, c), c) == k

test "turning the key over moves every card to a new seat"
    k = some_deck(7)
    t = turned_over(k)
    for i = 0 to 51
        assert t[i] != k[i]
    assert turned_over(t) == k

test "wire ranks: sorted is 0, turned-over sorted is 52! - 1, 52! is not a deck"
    z = rank29(sorted_deck())
    assert bn_is_zero(z)
    top = rank29(turned_over(sorted_deck()))
    ok, d = wire_to_deck(top)
    assert ok
    assert d == turned_over(sorted_deck())
    one = filled(wire_block, 0)
    one[wire_block - 1] = 1
    ok2, d2 = wire_to_deck(bn_add(top, one))
    assert not ok2
    k = some_deck(7)
    ok3, d3 = wire_to_deck(rank29(k))
    assert ok3
    assert d3 == k

test "28-byte blocks round-trip; a deck of rank at least 2^224 is not a message block"
    b = filled(msg_block, 255)
    ok, back = deck_to_block(block_to_deck(b))
    assert ok
    assert back == b
    okr, r = deck_to_block(turned_over(sorted_deck()))
    assert not okr

test "group order is 29 bytes with top byte 3"
    g = group_order()
    assert g.length == wire_block
    assert g[0] == 3

test "pad and checked unpad"
    e = pad_iso7816([])
    assert e.length == 28
    ok, m = unpad_checked(e)
    assert ok
    assert m.length == 0
    x: List<int> = []
    for i = 0 to 27
        x.append(i + 1)
    ok2, m2 = unpad_checked(pad_iso7816(x))
    assert ok2
    assert m2 == x
    bad = pad_iso7816([1, 2, 3])
    bad[3] = 0
    ok3, m3 = unpad_checked(bad)
    assert not ok3
    late = [128] + filled(55, 0)
    ok4, m4 = unpad_checked(late)
    assert not ok4

test "the MAC input: version deck first, length deck last, zero-filled AAD kept apart"
    iv = some_deck(7)
    c = [some_deck(11)]
    s0 = mac_decks([], iv, c)
    assert s0.length == 4
    assert s0[0] == version_deck()
    assert s0[0] != sorted_deck()
    assert s0[1] == iv
    assert s0[3] == sorted_deck()
    s1 = mac_decks([0], iv, c)
    s27 = mac_decks(filled(27, 0), iv, c)
    s28 = mac_decks(filled(28, 0), iv, c)
    s29 = mac_decks(filled(29, 0), iv, c)
    assert s1.length == 5
    assert s1[1] == s27[1]
    assert s1[4] != s27[4]
    assert s27[4] != s28[4]
    assert s29.length == 6

test "the Sandwich tag is one megaminx through key, message decks, key turned over"
    k = some_deck(7)
    s = mac_decks([1, 2], some_deck(11), [some_deck(15)])
    seq: List<List<int>> = []
    seq.append(md_ids(k))
    for i = 0 to s.length - 1
        seq.append(md_ids(s[i]))
    seq.append(md_ids(turned_over(k)))
    assert mac_tag(k, s) == megadreifach.HashDecksBody(seq)
    assert mac_tag(k, s) != mac_tag(turned_over(k), s)
    assert mac_tag(k, s).length == tag_len

test "card ids: the same physical card in MegaDreifach numbering"
    ids = md_ids(sorted_deck())
    assert ids[0] == 0
    assert ids[1] == 4
    assert ids[13] == 1
    assert ids[51] == 51

test "optional key derivation gives two distinct decks"
    a, b = derive_key_decks([1, 2, 3])
    assert is_deck(a)
    assert is_deck(b)
    assert a != b
    c, d = derive_key_decks([1, 2, 4])
    assert c != a

test "optional key derivation rejects an empty master"
    expect_trap AssertFailed
        a, b = derive_key_decks([])

test "published mac_version_only (kats/doubledeal_cbc_hmac_kats.json)"
    k = [11, 30, 26, 38, 13, 44, 15, 6, 24, 35, 37, 27, 33, 32, 21, 10, 43, 4, 49, 18, 42, 19, 51, 3, 23, 41, 5, 45, 0, 50, 47, 36, 39, 31, 8, 46, 1, 22, 20, 48, 34, 17, 14, 29, 12, 9, 28, 7, 25, 2, 16, 40]
    assert mac_tag(k, [version_deck()]) == [1, 244, 194, 178, 105, 103, 90, 186, 53, 202, 56, 17, 144, 72, 162, 174, 96, 106, 207, 14, 5, 177, 184, 5, 255, 18, 168, 54, 66]

test "aead_seal then aead_open round-trips and every tamper rejects"
    ke = some_deck(7)
    km = some_deck(11)
    iv = some_deck(15)
    pt = [104, 105]
    blob = aead_seal(pt, ke, km, [9], iv)
    assert blob.length == 3 * wire_block
    ok, back = aead_open(blob, ke, km, [9])
    assert ok
    assert back == pt
    t = blob
    t[blob.length - 1] = (t[blob.length - 1] + 1) mod 256
    okt, bt = aead_open(t, ke, km, [9])
    assert not okt
    assert bt.length == 0
    c = blob
    c[40] = (c[40] + 1) mod 256
    okc, bc = aead_open(c, ke, km, [9])
    assert not okc
    oka, ba = aead_open(blob, ke, km, [8])
    assert not oka
    okk, bk = aead_open(blob, km, ke, [9])
    assert not okk
    short: List<int> = []
    for i = 0 to blob.length - wire_block - 1
        short.append(blob[i])
    oks, bs = aead_open(short, ke, km, [9])
    assert not oks

test "a blob number that is not a deck is rejected by the public parse"
    ke = some_deck(7)
    km = some_deck(11)
    blob = aead_seal([], ke, km, [], some_deck(15))
    for j = 0 to wire_block - 1
        blob[j] = 255
    ok, m = aead_open(blob, ke, km, [])
    assert not ok

test "the two key decks must differ"
    k = some_deck(7)
    expect_trap AssertFailed
        b = aead_seal([1], k, k, [], some_deck(11))

test "longer messages chain through the previous ciphertext deck"
    ke = some_deck(7)
    km = some_deck(11)
    pt: List<int> = []
    for i = 0 to 59
        pt.append((i * 37) mod 256)
    blob = aead_seal(pt, ke, km, [], some_deck(15))
    assert blob.length == 5 * wire_block
    ok, back = aead_open(blob, ke, km, [])
    assert ok
    assert back == pt
