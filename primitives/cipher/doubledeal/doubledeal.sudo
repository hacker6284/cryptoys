// DoubleDeal v10. The rules are primitives/cipher/doubledeal/SPEC.md.
// v9 and v8 are deprecated and frozen under primitives/cipher/doubledeal/v9/ and v8/.
// A toy block cipher on a 52-card deck. Not for real use.

func suit_of(c: int) -> int
    return c / 13

func rank_of(c: int) -> int
    return (c mod 13) + 1

func left_rotate(xs: List<int>, k: int) -> List<int>
    n = xs.length
    if n == 0
        return xs
    k = k mod n
    if k == 0
        return xs
    out: List<int> = []
    for i = k to n - 1
        out.append(xs[i])
    for i = 0 to k - 1
        out.append(xs[i])
    return out

func right_rotate(xs: List<int>, k: int) -> List<int>
    n = xs.length
    if n == 0
        return xs
    k = k mod n
    if k == 0
        return xs
    return left_rotate(xs, n - k)

func empty_rows() -> List<List<int>>
    g: List<List<int>> = []
    for r = 0 to 3
        row: List<int> = []
        for c = 0 to 12
            row.append(-1)
        g.append(row)
    return g

func lay_cm(d: List<int>) -> List<List<int>>
    g = empty_rows()
    for k = 0 to 51
        r = k mod 4
        c = k / 4
        row = g[r]
        row[c] = d[k]
        g[r] = row
    return g

func scoop_cm(g: List<List<int>>) -> List<int>
    out: List<int> = []
    for c = 0 to 12
        for r = 0 to 3
            out.append(g[r][c])
    return out

func lay_rm(d: List<int>) -> List<List<int>>
    g: List<List<int>> = []
    for i = 0 to 3
        row: List<int> = []
        for j = 0 to 12
            row.append(d[13 * i + j])
        g.append(row)
    return g

func scoop_rm(g: List<List<int>>) -> List<int>
    out: List<int> = []
    for r = 0 to 3
        for c = 0 to 12
            out.append(g[r][c])
    return out

// SumRanks reads each card twice: its rank for the rows, its suit for the columns.
// Rows: a row turns by the index-weighted rank total of the row above it.
// Columns: suits are the four elements of GF(4), labelled clubs 0, diamonds 1,
// hearts w = 2, spades w^2 = 3 (two bits each; w^2 = w + 1).

// Weighted rank total of one row: 13 x the first card's rank, 12 x the second,
// ..., 1 x the last. By hand: two running totals, t += rank, then u += t.
func row_total(row: List<int>) -> int
    total = 0
    for j = 0 to 12
        total = total + (13 - j) * rank_of(row[j])
    return total

func row_turn(row: List<int>) -> int
    return row_total(row) mod 13

// Rows turn in the order 1, 2, 3, 0. Row i turns left by the turn of row
// i - 1 (row 0 reads row 3) as that row is at the moment.
func sum_rows(g: List<List<int>>) -> List<List<int>>
    for a = 1 to 4
        i = a mod 4
        g[i] = left_rotate(g[i], row_turn(g[(i + 3) mod 4]))
    return g

func inv_sum_rows(g: List<List<int>>) -> List<List<int>>
    for a = 0 to 3
        i = (4 - a) mod 4
        g[i] = left_rotate(g[i], 0 - row_turn(g[(i + 3) mod 4]))
    return g

// Suit label in GF(4): clubs 0, hearts w (2), spades w^2 (3), diamonds 1.
func suit_label(c: int) -> int
    s = suit_of(c)
    if s == 0
        return 0
    return (s mod 3) + 1

// GF(4) addition (XOR of the two bits): a pair cancels, clubs change nothing,
// two different non-club suits make the third.
func gf_add(a: int, b: int) -> int
    low = ((a mod 2) + (b mod 2)) mod 2
    high = ((a / 2) + (b / 2)) mod 2
    return low + 2 * high

// GF(4) multiplication by w: diamonds -> hearts -> spades -> diamonds; clubs stay.
func gf_times_w(x: int) -> int
    if x == 0
        return 0
    return (x mod 3) + 1

// Weighted suit value of column p: 0 s0 + 1 s1 + w s2 + w^2 s3 in GF(4)
// (s_i = label of the card in row i). The four weights are distinct.
func column_value(g: List<List<int>>, p: int) -> int
    v = suit_label(g[1][p])
    v = gf_add(v, gf_times_w(suit_label(g[2][p])))
    return gf_add(v, gf_times_w(gf_times_w(suit_label(g[3][p]))))

// GF(4) sum of the four suit labels of column j. Turning the column does not change it.
func column_suits(g: List<List<int>>, j: int) -> int
    v = gf_add(suit_label(g[0][j]), suit_label(g[1][j]))
    v = gf_add(v, suit_label(g[2][j]))
    return gf_add(v, suit_label(g[3][j]))

// Column j's turn: the weighted value of column j - 1 (column 0 reads column 12)
// plus column j's own suit sum.
func column_turn(g: List<List<int>>, j: int) -> int
    return gf_add(column_value(g, (j + 12) mod 13), column_suits(g, j))

// Cycle column j top to bottom by s (s may be negative).
func turn_column(g: List<List<int>>, j: int, s: int) -> List<List<int>>
    col: List<int> = []
    for i = 0 to 3
        col.append(g[i][j])
    fresh: List<int> = []
    for i = 0 to 3
        fresh.append(col[(i - s) mod 4])
    for i = 0 to 3
        row = g[i]
        row[j] = fresh[i]
        g[i] = row
    return g

// Columns turn in the order 1, 2, ..., 12, 0, each reading its left neighbour
// as that column is at the moment.
func sum_columns(g: List<List<int>>) -> List<List<int>>
    for a = 1 to 13
        j = a mod 13
        g = turn_column(g, j, column_turn(g, j))
    return g

func inv_sum_columns(g: List<List<int>>) -> List<List<int>>
    for a = 0 to 12
        j = (13 - a) mod 13
        g = turn_column(g, j, 0 - column_turn(g, j))
    return g

func sum_ranks(g: List<List<int>>) -> List<List<int>>
    return sum_columns(sum_rows(g))

func inv_sum_ranks(g: List<List<int>>) -> List<List<int>>
    return inv_sum_rows(inv_sum_columns(g))

func shift_rows(g: List<List<int>>) -> List<List<int>>
    for i = 0 to 3
        g[i] = left_rotate(g[i], i)
    return g

func inv_shift_rows(g: List<List<int>>) -> List<List<int>>
    for i = 0 to 3
        g[i] = left_rotate(g[i], 0 - i)
    return g

// Scan one marker row for its first free seat (0 in occ), starting at column
// `start` (the blocked seat's column) and wrapping from 12 back to 0. -1 if full.
func scan_row(occ: List<List<int>>, row: int, start: int) -> int
    found = -1
    for k = 0 to 12
        col = (start + k) mod 13
        if (found < 0) and (occ[row][col] == 0)
            found = col
    return found

func overflow_seat(occ: List<List<int>>, t: int, start: int) -> (int, int, int)
    for attempt = 0 to 3
        row = t
        found = scan_row(occ, row, start)
        if found >= 0
            return (row, found, (t + 1) mod 4)
        t = (t + 1) mod 4
    assert false
    return (0, 0, 0)

func step_seat(card: int, r: int, c: int) -> (int, int)
    return ((r + suit_of(card)) mod 4, (c + rank_of(card)) mod 13)

func mix_columns(d: List<int>) -> List<int>
    grid = empty_rows()
    t = 0
    prev_card = 0
    prev_r = 0
    prev_c = 0
    for i = 0 to 51
        card = d[i]
        r = 2
        c = 0
        if i > 0
            tr, tc = step_seat(prev_card, prev_r, prev_c)
            if grid[tr][tc] < 0
                r = tr
                c = tc
            else
                occ: List<List<int>> = []
                for rr = 0 to 3
                    marks: List<int> = []
                    for cc = 0 to 12
                        if grid[rr][cc] < 0
                            marks.append(0)
                        else
                            marks.append(1)
                    occ.append(marks)
                r, c, t = overflow_seat(occ, t, tc)
        row = grid[r]
        row[c] = card
        grid[r] = row
        prev_card = card
        prev_r = r
        prev_c = c
    return scoop_rm(grid)

func inv_mix_columns(d: List<int>) -> List<int>
    grid = lay_rm(d)
    visited = empty_rows()
    for r = 0 to 3
        row = visited[r]
        for c = 0 to 12
            row[c] = 0
        visited[r] = row
    t = 0
    hand: List<int> = []
    prev_card = 0
    prev_r = 0
    prev_c = 0
    for i = 0 to 51
        r = 2
        c = 0
        if i > 0
            tr, tc = step_seat(prev_card, prev_r, prev_c)
            if visited[tr][tc] == 0
                r = tr
                c = tc
            else
                r, c, t = overflow_seat(visited, t, tc)
        hand.append(grid[r][c])
        row = visited[r]
        row[c] = 1
        visited[r] = row
        prev_card = hand[hand.length - 1]
        prev_r = r
        prev_c = c
    return hand

func index_of(deck: List<int>, card: int) -> int
    for i = 0 to 51
        if deck[i] == card
            return i
    assert false
    return 0

func compose(m: List<int>, k: List<int>) -> List<int>
    out: List<int> = []
    for j = 0 to 51
        out.append(m[index_of(k, j)])
    return out

func inverse_compose(c: List<int>, k: List<int>) -> List<int>
    out = filled(52, 0)
    for j = 0 to 51
        out[index_of(k, j)] = c[j]
    return out

func push_front(xs: List<int>, c: int) -> List<int>
    out: List<int> = []
    out.append(c)
    for i = 0 to xs.length - 1
        out.append(xs[i])
    return out

func drop_front(xs: List<int>) -> (int, List<int>)
    c = xs[0]
    rest: List<int> = []
    for i = 1 to xs.length - 1
        rest.append(xs[i])
    return (c, rest)

func passkey(deck: List<int>) -> List<int>
    hand = deck
    key: List<int> = []
    n = deck.length
    for i = 1 to n
        c, hand = drop_front(hand)
        if hand.length > 0
            k = suit_of(c) mod hand.length
            if k > 0
                hand = left_rotate(hand, k)
        if (hand.length > 0) and (rank_of(c) < hand.length)
            hand = left_rotate(hand, rank_of(c))
        else if (key.length > 0) and (rank_of(c) < key.length)
            key = left_rotate(key, rank_of(c))
        key = push_front(key, c)
    return key

func passkey_inv(deck: List<int>) -> List<int>
    key = deck
    hand: List<int> = []
    n_deck = deck.length
    for i = 1 to n_deck
        c, key = drop_front(key)
        n = hand.length
        if (n > 0) and (rank_of(c) < n)
            hand = right_rotate(hand, rank_of(c))
        else if (key.length > 0) and (rank_of(c) < key.length)
            key = right_rotate(key, rank_of(c))
        if n > 0
            k = suit_of(c) mod n
            if k > 0
                hand = right_rotate(hand, k)
        hand = push_front(hand, c)
    return hand

func expand_keys(k0: List<int>) -> List<List<int>>
    keys: List<List<int>> = []
    keys.append(k0)
    for r = 1 to 6
        keys.append(passkey(keys[r - 1]))
    return keys

func unkeyed_full(m: List<int>) -> List<int>
    g = shift_rows(sum_ranks(lay_cm(m)))
    return mix_columns(scoop_cm(g))

func full_round(m: List<int>, kr: List<int>) -> List<int>
    return compose(unkeyed_full(m), kr)

func inv_full_round(c: List<int>, kr: List<int>) -> List<int>
    m = inv_mix_columns(inverse_compose(c, kr))
    g = inv_sum_ranks(inv_shift_rows(lay_cm(m)))
    return scoop_cm(g)

func final_round(m: List<int>, kr: List<int>) -> List<int>
    g = shift_rows(sum_ranks(lay_cm(m)))
    return compose(scoop_cm(g), kr)

func inv_final_round(c: List<int>, kr: List<int>) -> List<int>
    m = inverse_compose(c, kr)
    g = inv_sum_ranks(inv_shift_rows(lay_cm(m)))
    return scoop_cm(g)

record Step
    kind: text
    label: text
    message: List<int>
    key: List<int>
    hand: List<int>
    row: int
    col: int
    amount: int
    total: int
    card: int
    flag: int

func no_cards() -> List<int>
    empty: List<int> = []
    return empty

func add_step(steps: List<Step>, kind: text, label: text, message: List<int>, key: List<int>, hand: List<int>, row: int, col: int, amount: int, total: int, card: int, flag: int) -> List<Step>
    steps.append(Step(kind, label, message, key, hand, row, col, amount, total, card, flag))
    return steps

func round_label(prefix: text, r: int) -> text
    digits = "0123456789"
    out = prefix
    out.append(digits[r])
    return out

func trace_pass(deck: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    hand = deck
    key: List<int> = []
    n = deck.length
    for i = 1 to n
        c, next_hand = drop_front(hand)
        suit_cut = 0
        if next_hand.length > 0
            suit_cut = suit_of(c) mod next_hand.length
            if suit_cut > 0
                next_hand = left_rotate(next_hand, suit_cut)
        rank_cut = 0
        cut_on = 0
        if (next_hand.length > 0) and (rank_of(c) < next_hand.length)
            rank_cut = rank_of(c)
            cut_on = 1
            next_hand = left_rotate(next_hand, rank_cut)
        else if (key.length > 0) and (rank_of(c) < key.length)
            rank_cut = rank_of(c)
            cut_on = 2
            key = left_rotate(key, rank_cut)
        key = push_front(key, c)
        hand = next_hand
        steps = add_step(steps, "pass", label, no_cards(), key, hand, suit_of(c), rank_of(c), suit_cut, rank_cut, c, cut_on)
    return (key, steps)

func trace_unpass(deck: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    key = deck
    hand: List<int> = []
    n_deck = deck.length
    for i = 1 to n_deck
        c, next_key = drop_front(key)
        n = hand.length
        rank_cut = 0
        cut_on = 0
        if (n > 0) and (rank_of(c) < n)
            rank_cut = rank_of(c)
            cut_on = 1
            hand = right_rotate(hand, rank_cut)
        else if (next_key.length > 0) and (rank_of(c) < next_key.length)
            rank_cut = rank_of(c)
            cut_on = 2
            next_key = right_rotate(next_key, rank_cut)
        suit_cut = 0
        if n > 0
            suit_cut = suit_of(c) mod n
            if suit_cut > 0
                hand = right_rotate(hand, suit_cut)
        hand = push_front(hand, c)
        key = next_key
        steps = add_step(steps, "unpass", label, no_cards(), key, hand, suit_of(c), rank_of(c), suit_cut, rank_cut, c, cut_on)
    return (hand, steps)

// Steps: "sumrow" (row, amount = turn, total = weighted total of the row read,
// flag = that row); "sumcol" (col, amount = turn, total = weighted value of the
// column read, flag = own suit sum). Inverse steps carry a negative amount.
func trace_sum(g: List<List<int>>, steps: List<Step>, label: text) -> (List<List<int>>, List<Step>)
    for a = 1 to 4
        i = a mod 4
        above = (i + 3) mod 4
        total = row_total(g[above])
        amount = total mod 13
        g[i] = left_rotate(g[i], amount)
        steps = add_step(steps, "sumrow", label, no_cards(), no_cards(), no_cards(), i, -1, amount, total, -1, above)
    for a = 1 to 13
        j = a mod 13
        amount = column_turn(g, j)
        g = turn_column(g, j, amount)
        steps = add_step(steps, "sumcol", label, no_cards(), no_cards(), no_cards(), -1, j, amount, column_value(g, (j + 12) mod 13), -1, column_suits(g, j))
    return (g, steps)

func trace_shift(g: List<List<int>>, steps: List<Step>, label: text) -> (List<List<int>>, List<Step>)
    for i = 0 to 3
        g[i] = left_rotate(g[i], i)
        steps = add_step(steps, "shift", label, no_cards(), no_cards(), no_cards(), i, -1, i, 0, -1, 0)
    return (g, steps)

func trace_mix(d: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    grid = empty_rows()
    t = 0
    prev_card = 0
    prev_r = 0
    prev_c = 0
    for i = 0 to 51
        card = d[i]
        r = 2
        c = 0
        overflowed = 0
        if i == 0
            steps = add_step(steps, "mark", label, no_cards(), no_cards(), no_cards(), 2, 0, 0, 0, card, 0)
        else
            tr, tc = step_seat(prev_card, prev_r, prev_c)
            if grid[tr][tc] < 0
                r = tr
                c = tc
            else
                overflowed = 1
                occ: List<List<int>> = []
                for rr = 0 to 3
                    marks: List<int> = []
                    for cc = 0 to 12
                        if grid[rr][cc] < 0
                            marks.append(0)
                        else
                            marks.append(1)
                    occ.append(marks)
                scan = t
                found = -1
                for tries = 0 to 3
                    if found < 0
                        steps = add_step(steps, "scan", label, no_cards(), no_cards(), no_cards(), scan, tc, 0, 0, card, 1)
                        found = scan_row(occ, scan, tc)
                        if found >= 0
                            r = scan
                            c = found
                            t = (scan + 1) mod 4
                        else
                            scan = (scan + 1) mod 4
                            t = scan
        row = grid[r]
        row[c] = card
        grid[r] = row
        steps = add_step(steps, "place", label, no_cards(), no_cards(), no_cards(), r, c, 0, 0, card, overflowed)
        prev_card = card
        prev_r = r
        prev_c = c
    return (scoop_rm(grid), steps)

func trace_full_round(m: List<int>, kr: List<int>, steps: List<Step>, tag: text) -> (List<int>, List<Step>)
    steps = add_step(steps, "deal", tag, m, kr, no_cards(), -1, -1, 0, 0, -1, 0)
    g, steps = trace_sum(lay_cm(m), steps, tag)
    g, steps = trace_shift(g, steps, tag)
    scooped = scoop_cm(g)
    steps = add_step(steps, "scoopcm", tag, scooped, kr, no_cards(), -1, -1, 0, 0, -1, 0)
    mixed, steps = trace_mix(scooped, steps, tag)
    steps = add_step(steps, "scooprm", tag, mixed, kr, no_cards(), -1, -1, 0, 0, -1, 0)
    out = compose(mixed, kr)
    steps = add_step(steps, "compose", tag, mixed, kr, out, -1, -1, 0, 0, -1, 0)
    return (out, steps)

func trace_final_round(m: List<int>, kr: List<int>, steps: List<Step>) -> (List<int>, List<Step>)
    tag = "Final round · no GridCycle"
    steps = add_step(steps, "deal", tag, m, kr, no_cards(), -1, -1, 0, 0, -1, 1)
    g, steps = trace_sum(lay_cm(m), steps, tag)
    g, steps = trace_shift(g, steps, tag)
    scooped = scoop_cm(g)
    steps = add_step(steps, "scoopcm", tag, scooped, kr, no_cards(), -1, -1, 0, 0, -1, 1)
    out = compose(scooped, kr)
    steps = add_step(steps, "compose", "Final Compose · ciphertext", scooped, kr, out, -1, -1, 0, 0, -1, 1)
    return (out, steps)

export func trace_encrypt(message: List<int>, key: List<int>) -> List<Step>
    steps: List<Step> = []
    whitened = compose(message, key)
    steps = add_step(steps, "compose", "Whitening · Compose · AddRoundKey", message, key, whitened, -1, -1, 0, 0, -1, 0)
    m = whitened
    built = key
    for r = 1 to 5
        built, steps = trace_pass(built, steps, round_label("PassKey K", r))
        m, steps = trace_full_round(m, built, steps, round_label("Round ", r))
    built, steps = trace_pass(built, steps, round_label("PassKey K", 6))
    m, steps = trace_final_round(m, built, steps)
    return steps

export func trace_ecb(blocks: List<List<int>>, key: List<int>) -> List<Step>
    steps: List<Step> = []
    for i = 0 to blocks.length - 1
        one = trace_encrypt(blocks[i], key)
        for n = 0 to one.length - 1
            steps.append(one[n])
    return steps

func trace_uncompose(c: List<int>, kr: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    out = inverse_compose(c, kr)
    steps = add_step(steps, "uncompose", label, c, kr, out, -1, -1, 0, 0, -1, 0)
    return (out, steps)

func trace_inv_shift(g: List<List<int>>, steps: List<Step>, label: text) -> (List<List<int>>, List<Step>)
    for i = 0 to 3
        g[i] = left_rotate(g[i], 0 - i)
        steps = add_step(steps, "shift", label, no_cards(), no_cards(), no_cards(), i, -1, 0 - i, 0, -1, 0)
    return (g, steps)

func trace_inv_sum(g: List<List<int>>, steps: List<Step>, label: text) -> (List<List<int>>, List<Step>)
    for a = 0 to 12
        j = (13 - a) mod 13
        amount = column_turn(g, j)
        g = turn_column(g, j, 0 - amount)
        steps = add_step(steps, "sumcol", label, no_cards(), no_cards(), no_cards(), -1, j, 0 - amount, column_value(g, (j + 12) mod 13), -1, column_suits(g, j))
    for a = 0 to 3
        i = (4 - a) mod 4
        above = (i + 3) mod 4
        total = row_total(g[above])
        amount = total mod 13
        g[i] = left_rotate(g[i], 0 - amount)
        steps = add_step(steps, "sumrow", label, no_cards(), no_cards(), no_cards(), i, -1, 0 - amount, total, -1, above)
    return (g, steps)

func trace_inv_mix(d: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    steps = add_step(steps, "dealrm", label, d, no_cards(), no_cards(), -1, -1, 0, 0, -1, 0)
    grid = lay_rm(d)
    visited = empty_rows()
    for r = 0 to 3
        row = visited[r]
        for c = 0 to 12
            row[c] = 0
        visited[r] = row
    t = 0
    hand: List<int> = []
    prev_card = 0
    prev_r = 0
    prev_c = 0
    for i = 0 to 51
        r = 2
        c = 0
        if i > 0
            tr, tc = step_seat(prev_card, prev_r, prev_c)
            if visited[tr][tc] == 0
                r = tr
                c = tc
            else
                scan = t
                found = -1
                for tries = 0 to 3
                    if found < 0
                        steps = add_step(steps, "scan", label, no_cards(), no_cards(), no_cards(), scan, tc, 0, 0, -1, 1)
                        found = scan_row(visited, scan, tc)
                        if found >= 0
                            r = scan
                            c = found
                            t = (scan + 1) mod 4
                        else
                            scan = (scan + 1) mod 4
                            t = scan
        card = grid[r][c]
        steps = add_step(steps, "take", label, no_cards(), no_cards(), no_cards(), r, c, i, 0, card, 0)
        hand.append(card)
        row = visited[r]
        row[c] = 1
        visited[r] = row
        prev_card = card
        prev_r = r
        prev_c = c
    return (hand, steps)

func trace_inv_final(c: List<int>, kr: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    m, steps = trace_uncompose(c, kr, steps, label)
    steps = add_step(steps, "deal", label, m, kr, no_cards(), -1, -1, 0, 0, -1, 1)
    g, steps = trace_inv_shift(lay_cm(m), steps, label)
    g, steps = trace_inv_sum(g, steps, label)
    scooped = scoop_cm(g)
    steps = add_step(steps, "scoopcm", label, scooped, kr, no_cards(), -1, -1, 0, 0, -1, 1)
    return (scooped, steps)

func trace_inv_full(c: List<int>, kr: List<int>, steps: List<Step>, label: text) -> (List<int>, List<Step>)
    mixed, steps = trace_uncompose(c, kr, steps, label)
    packet, steps = trace_inv_mix(mixed, steps, label)
    steps = add_step(steps, "deal", label, packet, kr, no_cards(), -1, -1, 0, 0, -1, 0)
    g, steps = trace_inv_shift(lay_cm(packet), steps, label)
    g, steps = trace_inv_sum(g, steps, label)
    scooped = scoop_cm(g)
    steps = add_step(steps, "scoopcm", label, scooped, kr, no_cards(), -1, -1, 0, 0, -1, 0)
    return (scooped, steps)

export func trace_decrypt(cipher: List<int>, key: List<int>) -> List<Step>
    steps: List<Step> = []
    built = key
    for r = 1 to 6
        built, steps = trace_pass(built, steps, round_label("PassKey K", r))
    m, steps = trace_inv_final(cipher, built, steps, "Inverse final round")
    for r = 5 downto 1
        built, steps = trace_unpass(built, steps, round_label("Un-pass K", r))
        m, steps = trace_inv_full(m, built, steps, round_label("Inverse round ", r))
    built, steps = trace_unpass(built, steps, "Un-pass K0")
    m, steps = trace_uncompose(m, built, steps, "InverseCompose · K0")
    return steps

export func trace_ctr(blocks: List<List<int>>, key: List<int>, nonce: List<int>) -> List<Step>
    steps: List<Step> = []
    for i = 0 to blocks.length - 1
        counter = counter_deck(nonce, i)
        steps = add_step(steps, "counter", "CTR counter", counter, key, blocks[i], -1, -1, i, 0, -1, 0)
        stream = encrypt(counter, key)
        walked = trace_encrypt(counter, key)
        for n = 0 to walked.length - 1
            steps.append(walked[n])
        mixed = compose(blocks[i], stream)
        steps = add_step(steps, "compose", "CTR Compose message with keystream", blocks[i], stream, mixed, -1, -1, i, 0, -1, 0)
    return steps

export func trace_ctr_decrypt(blocks: List<List<int>>, key: List<int>, nonce: List<int>) -> List<Step>
    steps: List<Step> = []
    for i = 0 to blocks.length - 1
        counter = counter_deck(nonce, i)
        steps = add_step(steps, "counter", "CTR counter", counter, key, blocks[i], -1, -1, i, 0, -1, 0)
        stream = encrypt(counter, key)
        walked = trace_encrypt(counter, key)
        for n = 0 to walked.length - 1
            steps.append(walked[n])
        plain = inverse_compose(blocks[i], stream)
        steps = add_step(steps, "uncompose", "CTR InverseCompose", blocks[i], stream, plain, -1, -1, i, 0, -1, 0)
    return steps

export func encrypt(message: List<int>, key: List<int>) -> List<int>
    keys = expand_keys(key)
    m = compose(message, keys[0])
    for r = 1 to 5
        m = full_round(m, keys[r])
    return final_round(m, keys[6])

export func decrypt(cipher: List<int>, key: List<int>) -> List<int>
    built = key
    for r = 1 to 6
        built = passkey(built)
    m = inv_final_round(cipher, built)
    for r = 5 downto 1
        built = passkey_inv(built)
        m = inv_full_round(m, built)
    built = passkey_inv(built)
    return inverse_compose(m, built)

func factorial(n: int) -> int
    r = 1
    for i = 2 to n
        r = r * i
    return r

func unrank(items: List<int>, rank: int) -> List<int>
    n = items.length
    rank = rank mod factorial(n)
    out: List<int> = []
    for k = n downto 1
        f = factorial(k - 1)
        idx = rank / f
        rank = rank mod f
        out.append(items[idx])
        rest: List<int> = []
        for i = 0 to items.length - 1
            if i != idx
                rest.append(items[i])
        items = rest
    return out

func diamond_cards() -> List<int>
    out: List<int> = []
    for c = 39 to 51
        out.append(c)
    return out

export func counter_deck(nonce: List<int>, index: int) -> List<int>
    assert nonce.length == 39
    diamonds = unrank(diamond_cards(), index)
    out: List<int> = []
    for i = 0 to 38
        out.append(nonce[i])
    for i = 0 to 12
        out.append(diamonds[i])
    return out

export func ecb_encrypt(blocks: List<List<int>>, key: List<int>) -> List<List<int>>
    out: List<List<int>> = []
    for i = 0 to blocks.length - 1
        out.append(encrypt(blocks[i], key))
    return out

export func ecb_decrypt(blocks: List<List<int>>, key: List<int>) -> List<List<int>>
    out: List<List<int>> = []
    for i = 0 to blocks.length - 1
        out.append(decrypt(blocks[i], key))
    return out

export func ctr_encrypt(blocks: List<List<int>>, key: List<int>, nonce: List<int>) -> List<List<int>>
    out: List<List<int>> = []
    for i = 0 to blocks.length - 1
        stream = encrypt(counter_deck(nonce, i), key)
        out.append(compose(blocks[i], stream))
    return out

export func ctr_decrypt(blocks: List<List<int>>, key: List<int>, nonce: List<int>) -> List<List<int>>
    out: List<List<int>> = []
    for i = 0 to blocks.length - 1
        stream = encrypt(counter_deck(nonce, i), key)
        out.append(inverse_compose(blocks[i], stream))
    return out

func sorted_copy(xs: List<int>) -> List<int>
    out = xs
    for i = 0 to out.length - 1
        for j = 0 to out.length - 2
            if out[j] > out[j + 1]
                a = out[j]
                out[j] = out[j + 1]
                out[j + 1] = a
    return out

func swap_card(c: int, x: int, y: int) -> int
    if c == x
        return y
    if c == y
        return x
    return c

func same_cards(a: List<int>, b: List<int>) -> bool
    return sorted_copy(a) == sorted_copy(b)

test "column and row deals are inverses"
    deck: List<int> = []
    for i = 0 to 51
        deck.append(i)
    assert scoop_cm(lay_cm(deck)) == deck
    assert scoop_rm(lay_rm(deck)) == deck

test "sum ranks and shift rows invert"
    deck: List<int> = []
    for i = 0 to 51
        deck.append((i * 17) mod 52)
    assert scoop_cm(inv_sum_ranks(sum_ranks(lay_cm(deck)))) == deck
    assert scoop_cm(inv_shift_rows(shift_rows(lay_cm(deck)))) == deck

test "grid cycle inverts"
    deck: List<int> = []
    for i = 0 to 51
        deck.append(51 - i)
    assert inv_mix_columns(mix_columns(deck)) == deck

test "compose inverts and passkey keeps the deck"
    deck: List<int> = []
    key: List<int> = []
    for i = 0 to 51
        deck.append(i)
        key.append(51 - i)
    assert inverse_compose(compose(deck, key), key) == deck
    derived = passkey(deck)
    assert derived.length == 52
    assert same_cards(derived, deck)

test "passkey inverse is a two-sided inverse"
    identity: List<int> = []
    reversed: List<int> = []
    for i = 0 to 51
        identity.append(i)
        reversed.append(51 - i)
    mixed = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    assert passkey_inv(passkey(identity)) == identity
    assert passkey(passkey_inv(identity)) == identity
    assert passkey_inv(passkey(reversed)) == reversed
    assert passkey(passkey_inv(reversed)) == reversed
    assert passkey_inv(passkey(mixed)) == mixed
    assert passkey(passkey_inv(mixed)) == mixed
    assert passkey_inv(passkey(key)) == key
    assert passkey(passkey_inv(key)) == key
    built = key
    for r = 1 to 6
        built = passkey(built)
    for r = 1 to 6
        built = passkey_inv(built)
    assert built == key

test "suit labels add and multiply in GF(4)"
    // Aces of clubs, hearts, spades, diamonds: labels 0, w, w^2, 1.
    assert suit_label(0) == 0
    assert suit_label(13) == 2
    assert suit_label(26) == 3
    assert suit_label(51) == 1
    for x = 0 to 3
        assert gf_add(x, x) == 0
        assert gf_add(0, x) == x
        assert gf_times_w(gf_times_w(gf_times_w(x))) == x
    assert gf_add(1, 2) == 3
    assert gf_add(2, 3) == 1
    assert gf_add(3, 1) == 2
    assert gf_times_w(0) == 0
    assert gf_times_w(1) == 2
    assert gf_times_w(2) == 3
    assert gf_times_w(3) == 1

test "row total is the two running totals"
    row = [5, 30, 12, 44, 0, 19, 38, 7, 25, 51, 13, 2, 33]
    t = 0
    u = 0
    for j = 0 to 12
        t = t + rank_of(row[j])
        u = u + t
    assert row_total(row) == u
    assert row_turn(row) == u mod 13

test "sum ranks leaves whole-suit rows alone"
    deck: List<int> = []
    for i = 0 to 51
        deck.append(i)
    g = lay_rm(deck)
    // Each row is one suit, ranks 1..13 in order: weighted total 455 = 35 x 13,
    // so no row turns. Every column reads clubs, hearts, spades, diamonds top to
    // bottom: weighted value 1 w + w w^2 + w^2 1 = w + 1 + w^2 = 0, own sum
    // 0 + w + w^2 + 1 = 0, so no column turns either (v9 turned each by 2).
    assert row_total(g[0]) == 455
    assert column_value(g, 12) == 0
    assert column_suits(g, 0) == 0
    assert sum_ranks(g) == g
    assert inv_sum_ranks(g) == g

test "sum ranks sees a K♣↔Q♥ swap that v9 missed"
    // K♣ (12) and Q♥ (24) share a row here. v9 SumRanks commuted with swapping
    // them on this deck (equal rank + suit mod 4); v10 does not.
    deck = [16, 10, 36, 14, 8, 41, 0, 45, 51, 7, 28, 26, 24, 11, 3, 39, 12, 35, 43, 1, 50, 15, 30, 22, 38, 4, 31, 44, 25, 33, 48, 20, 19, 42, 34, 17, 40, 9, 46, 32, 21, 13, 5, 27, 2, 18, 23, 47, 37, 6, 29, 49]
    swapped: List<int> = []
    for k = 0 to 51
        swapped.append(swap_card(deck[k], 12, 24))
    out = scoop_cm(sum_ranks(lay_cm(deck)))
    out_swapped = scoop_cm(sum_ranks(lay_cm(swapped)))
    relabelled: List<int> = []
    for k = 0 to 51
        relabelled.append(swap_card(out[k], 12, 24))
    assert out_swapped != relabelled
    assert scoop_cm(inv_sum_ranks(lay_cm(out_swapped))) == swapped

test "overflow scan starts at the blocked column"
    occ: List<List<int>> = []
    for r = 0 to 3
        marks: List<int> = []
        for c = 0 to 12
            if (r == 1) and ((c == 2) or (c == 7))
                marks.append(0)
            else
                marks.append(1)
        occ.append(marks)
    // Row 1 is free at columns 2 and 7. Blocked at column 5, v9 scans 5, 6, 7
    // and takes 7; v8 scanned from column 0 and took 2.
    assert scan_row(occ, 1, 5) == 7
    assert scan_row(occ, 1, 8) == 2
    assert scan_row(occ, 0, 5) == -1
    r, c, t = overflow_seat(occ, 1, 5)
    assert r == 1
    assert c == 7
    assert t == 2
    r2, c2, t2 = overflow_seat(occ, 0, 5)
    assert r2 == 1
    assert c2 == 7
    assert t2 == 2

test "decrypt undoes encrypt"
    message = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    cipher = [37, 19, 15, 33, 31, 13, 46, 4, 48, 8, 24, 43, 45, 0, 3, 18, 7, 44, 32, 10, 35, 51, 42, 41, 29, 40, 20, 23, 12, 26, 36, 27, 34, 1, 9, 6, 49, 39, 50, 11, 28, 47, 21, 2, 38, 5, 25, 22, 16, 14, 30, 17]
    assert encrypt(message, key) == cipher
    assert decrypt(cipher, key) == message

test "walking decrypt matches expand_keys decrypt"
    message = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    cipher = encrypt(message, key)
    keys = expand_keys(key)
    listed = inv_final_round(cipher, keys[6])
    for r = 5 downto 1
        listed = inv_full_round(listed, keys[r])
    listed = inverse_compose(listed, keys[0])
    assert listed == decrypt(cipher, key)
    assert listed == message

test "trace ends at the ciphertext"
    message = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    traced = trace_encrypt(message, key)
    last = traced[traced.length - 1]
    assert last.hand == encrypt(message, key)
    assert last.kind == "compose"
    marked = 0
    held = 0
    passes = 0
    for n = 0 to traced.length - 1
        if (traced[n].kind == "mark") and (traced[n].row == 2) and (traced[n].col == 0)
            marked = marked + 1
        if (traced[n].kind == "shift") and (traced[n].row == 0) and (traced[n].amount == 0)
            held = held + 1
        if traced[n].kind == "pass"
            passes = passes + 1
    assert marked == 5
    assert held == 6
    assert passes == 312

test "one key deck is passed between the rounds that use it"
    message = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    traced = trace_encrypt(message, key)
    assert traced[0].kind == "compose"
    assert traced[0].key == key
    i = 1
    built = key
    for r = 1 to 6
        built = passkey(built)
        for p = 0 to 51
            assert traced[i].kind == "pass"
            i = i + 1
        assert traced[i].kind == "deal"
        assert traced[i].key == built
        i = i + 1
        while traced[i].kind != "compose"
            assert traced[i].kind != "pass"
            i = i + 1
        assert traced[i].key == built
        i = i + 1
    assert i == traced.length

test "decrypt trace un-passes from K6"
    message = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    cipher = encrypt(message, key)
    traced = trace_decrypt(cipher, key)
    last = traced[traced.length - 1]
    assert last.kind == "uncompose"
    assert last.key == key
    assert last.hand == decrypt(cipher, key)
    assert last.hand == message
    i = 0
    passes = 0
    unpasses = 0
    built = key
    for r = 1 to 6
        built = passkey(built)
        for p = 0 to 51
            assert traced[i].kind == "pass"
            passes = passes + 1
            i = i + 1
    assert traced[i].kind == "uncompose"
    assert traced[i].key == built
    i = i + 1
    while traced[i].kind != "unpass"
        assert traced[i].kind != "pass"
        i = i + 1
    for r = 5 downto 0
        built = passkey_inv(built)
        for p = 0 to 51
            assert traced[i].kind == "unpass"
            unpasses = unpasses + 1
            i = i + 1
        assert traced[i].kind == "uncompose"
        assert traced[i].key == built
        i = i + 1
        if r > 0
            while traced[i].kind != "unpass"
                assert traced[i].kind != "pass"
                i = i + 1
    assert i == traced.length
    assert built == key
    assert passes == 312
    assert unpasses == 312

test "counter rail keeps the nonce and permutes diamonds"
    nonce: List<int> = []
    for i = 0 to 38
        nonce.append(i)
    a = counter_deck(nonce, 0)
    b = counter_deck(nonce, 1)
    for i = 0 to 38
        assert a[i] == i
        assert b[i] == i
    assert a[50] == 50
    assert a[51] == 51
    assert b[50] == 51
    assert b[51] == 50

test "ecb repeats a block and ctr does not"
    block = [0, 32, 38, 42, 13, 19, 17, 5, 41, 25, 48, 6, 31, 44, 3, 16, 7, 4, 34, 40, 18, 49, 14, 51, 20, 46, 28, 11, 10, 15, 45, 43, 2, 26, 22, 8, 37, 33, 12, 35, 24, 50, 39, 30, 21, 1, 27, 47, 36, 23, 29, 9]
    key = [48, 42, 25, 26, 3, 37, 39, 50, 11, 2, 43, 8, 10, 7, 40, 38, 34, 0, 49, 51, 22, 27, 23, 9, 12, 15, 44, 41, 21, 28, 20, 13, 19, 14, 45, 31, 35, 18, 17, 30, 6, 36, 47, 16, 1, 33, 29, 5, 46, 32, 24, 4]
    blocks: List<List<int>> = []
    blocks.append(block)
    blocks.append(block)
    ecb = ecb_encrypt(blocks, key)
    assert ecb[0] == ecb[1]
    assert ecb_decrypt(ecb, key) == blocks
    nonce: List<int> = []
    for i = 0 to 38
        nonce.append(38 - i)
    ctr = ctr_encrypt(blocks, key, nonce)
    assert ctr[0] != ctr[1]
    assert ctr_decrypt(ctr, key, nonce) == blocks
