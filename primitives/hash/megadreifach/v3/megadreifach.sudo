// MegaDreifach v3 (candidate; v2 stays current until a separate change). The rules are
// primitives/hash/megadreifach/v3/SPEC.md. A toy three-megaminx Merkle-Damgard hash. Not for real use.
// Product name MegaDreifach is locked. The puzzle/group is megaminx.
// v3 changes only the card phase W inside E_m (SPEC v3 §5): colour-named card steps with a last-face
// register (ZP26), no grips and no F3 rounds. Pad, φ, card ids, face-turn tables, IV-COOK12, chaining,
// Davies-Meyer (h' = compose(h, E_m(h)) = h·W·h) and the digest encoding are v2's, unchanged.
// A sudocode int is 64-bit and overflow traps; |G| and 52! need pasted bigint.
// Tests lock pad, φ, IV-COOK12, rank, the group law, the public API, the edge table, the colour
// naming (every block names all 50 pieces), and the v3 KATs (kats/megaminx_hash_kats_v3.json).

pad_block = 28
len_field = 8
digest_len = 29
body_len = 52
// 26 echoes of the held 52nd card after the deal (SPEC v3 §5.4).
echo_count = 26
limb_base = 1000000000
ori3_span = 1162261467
ori2_span = 536870912

record Position
    cp: List<int>
    co: List<int>
    ep: List<int>
    eo: List<int>

record BigInt
    negative: bool
    limbs: List<int>

opposites = [11, 9, 10, 6, 7, 8, 3, 4, 5, 1, 2, 0]

nbrs_0 = [1, 2, 3, 4, 5]
nbrs_1 = [0, 5, 6, 7, 2]
nbrs_2 = [0, 1, 7, 8, 3]
nbrs_3 = [0, 2, 8, 9, 4]
nbrs_4 = [0, 3, 9, 10, 5]
nbrs_5 = [0, 4, 10, 6, 1]
nbrs_6 = [1, 5, 10, 11, 7]
nbrs_7 = [1, 6, 11, 8, 2]
nbrs_8 = [2, 7, 11, 9, 3]
nbrs_9 = [3, 8, 11, 10, 4]
nbrs_10 = [4, 9, 11, 6, 5]
nbrs_11 = [6, 10, 9, 8, 7]

func face_nbrs(f: int) -> List<int>
    if f == 0
        return nbrs_0
    else if f == 1
        return nbrs_1
    else if f == 2
        return nbrs_2
    else if f == 3
        return nbrs_3
    else if f == 4
        return nbrs_4
    else if f == 5
        return nbrs_5
    else if f == 6
        return nbrs_6
    else if f == 7
        return nbrs_7
    else if f == 8
        return nbrs_8
    else if f == 9
        return nbrs_9
    else if f == 10
        return nbrs_10
    return nbrs_11

func corner_faces(slot: int) -> (int, int, int)
    if slot == 0
        return (0, 1, 2)
    else if slot == 1
        return (0, 2, 3)
    else if slot == 2
        return (0, 3, 4)
    else if slot == 3
        return (0, 4, 5)
    else if slot == 4
        return (0, 5, 1)
    else if slot == 5
        return (1, 5, 6)
    else if slot == 6
        return (1, 6, 7)
    else if slot == 7
        return (1, 7, 2)
    else if slot == 8
        return (2, 7, 8)
    else if slot == 9
        return (2, 8, 3)
    else if slot == 10
        return (3, 8, 9)
    else if slot == 11
        return (3, 9, 4)
    else if slot == 12
        return (4, 9, 10)
    else if slot == 13
        return (4, 10, 5)
    else if slot == 14
        return (5, 10, 6)
    else if slot == 15
        return (6, 10, 11)
    else if slot == 16
        return (6, 11, 7)
    else if slot == 17
        return (7, 11, 8)
    else if slot == 18
        return (8, 11, 9)
    return (9, 11, 10)

