            2, 6, 10, 9, 3, 1, 11, 2, 8, 2, 6, 8, 10, 9, 2, 10, 9, 9, 9, 9, 2, 6, 2, 5, 7,
            5, 1, 9, 5, 6, 4, 4],
        [5, 4, 2, 2, 1, 5, 6, 2, 2, 2, 3, 1, 3, 4, 2, 2, 4, 4, 5, 4, 1, 3, 3, 2, 3, 2, 4,
            5, 1, 1, 2, 3, 4, 3, 2, 3, 6, 3, 4, 4, 4, 3],
        [0, 0, 5, 5, 2, 7, 8, 6, 3, 4, 6, 9, 5, 6, 0, 5, 6, 7, 7, 8, 6, 5, 0, 4, 4, 9, 6,
            4, 0, 5, 5, 2, 8, 2, 0, 3, 4, 3, 0, 3, 3, 8, 4, 1, 5, 0, 0, 2, 0, 1, 6, 2, 9,
            4, 0, 1, 2, 2, 7, 4, 0, 8])

// Every face a build read, by kind, in order, from its reads.
func faces_read(reads: List<BuildRead>, kind: int) -> List<int>
    out: List<int> = []
    for i = 0 to reads.length - 1
        r = reads[i]
        got = r.cup
        if kind == 12
            got = r.d12
        else if kind == 6
            got = r.d6
        for j = 0 to got.length - 1
            out.append(got[j])
    return out

// A hole's moves say what its read says: the row cup's faces (five dice settle, in tray
// order), the hole die, the d6 rolls, the pieces ending in the ship laid on the holes it
// covers, the tray die read and the peg.
func check_build_moves(r: BuildRead, covered: List<bool>)
    cup: List<int> = []
    settled = 0
    d12: List<int> = []
    d6: List<int> = []
    last: List<Ship> = []
    read = 0
    for i = 0 to r.moves.length - 1
        match r.moves[i]
            case Throw(die, face)
                assert die == settled
                cup.append(face)
                if face != 0
                    settled = settled + 1
            case HoleDie(face)
                d12.append(face)
            case Grow(face)
                d6.append(face)
            case Pick(face)
                d6.append(face)
                assert last.length == 1
                assert ship_length(last[0].kind) == 3
            case Piece(s, holes)
                assert holes == ship_holes(s)
                assert (s.row * grid_cols + s.col == r.hole) and (s.down == r.ship[0].down)
                last = [s]
            case ReadDie(die, face)
                assert (die == r.die) and (face == r.face)
                read = read + 1
            case PutPeg(hole, colour, in_ship)
                assert (hole == r.hole) and (colour == r.peg) and (colour != 0)
                assert in_ship == covered[hole]
    assert (cup == r.cup) and (d12 == r.d12) and (d6 == r.d6) and (read == 1)
    assert (settled == 5) or (cup.length == 0)
    assert last == r.ship
    if r.ship.length == 1
        assert r.covered == ship_holes(r.ship[0])
    else
        assert r.covered.length == 0
    assert r.die == (r.hole mod grid_cols) / 2

// trace_build gives build_key_grid's grid, and its reads are exactly the faces it read,
// the ships it laid (in laying order, each at its first hole), its pegs and its moves.
func check_trace_build(source: Dice) -> KeyGrid
    built = build_key_grid(source)
    reads: List<BuildRead> = []
    grid = trace_build(source, reads)
    assert grid == built.grid
    assert reads.length == grid_rows * grid_cols
    assert faces_read(reads, 12) == faces_between(source.d12, 0, built.used12)
    assert faces_read(reads, 6) == faces_between(source.d6, 0, built.used6)
    assert faces_read(reads, 10) == faces_between(source.d10, 0, built.used10)
    laid: List<Ship> = []
    covered = filled(grid_rows * grid_cols, false)
    for h = 0 to reads.length - 1
        r = reads[h]
        assert r.hole == h
        assert (r.cup.length > 0) == (h mod grid_cols == 0)
        assert (r.face >= 1) and (r.face <= 9)
        if h mod 2 == 0
            assert r.peg == keypad_first(r.face)
        else
            assert r.peg == keypad_second(r.face)
            assert r.face == reads[h - 1].face
        assert r.peg == grid.pegs[h]
        for k = 0 to r.ship.length - 1
            assert ship_holes(r.ship[k])[0] == h
            laid.append(r.ship[k])
            cover(covered, r.ship[k])
        check_build_moves(r, covered)
    assert laid == grid.ships
    return grid

// Apply one peg move to a player's board (x, y, c and the strip s), checking its `from`.
func apply_move(x: inout List<int>, y: inout List<int>, c: inout List<int>, s: inout List<int>, m: PegMove)
    match m.reg
        case X
            assert x[m.hole] == m.from
            x[m.hole] = m.into
        case Y
            assert y[m.hole] == m.from
            y[m.hole] = m.into
        case C
            assert c[m.hole] == m.from
            c[m.hole] = m.into
        case Strip
            assert s[m.hole] == m.from
            s[m.hole] = m.into

// Every step of a trace is what it says: a multiplication's register is multiply of its
// operands (and trace_multiply's), the registers it does not name are as the player's
// last step left them, and its peg moves (step_moves) replayed on the board from the
// last step's registers land exactly on this step's, with the strip clear again.
func check_trace_steps(f: Field, steps: List<TraceStep>)
    xs = [empty_register(f), empty_register(f)]
    ys = [empty_register(f), empty_register(f)]
    cs = [empty_register(f), empty_register(f)]
    for i = 0 to steps.length - 1
        st = steps[i]
        p = st.player
        assert (p == 0) or (p == 1)
        product = empty_register(f)
        if st.a.length > 0
            product = multiply(f, st.a, st.b, st.nudge)
            twin: List<PegMove> = []
            assert trace_multiply(f, st.a, st.b, st.nudge, twin) == product
        match st.op
            case Square
                assert (st.y == product) and (st.x == xs[p]) and (st.c == cs[p])
                assert (st.a == xs[p]) and (st.b == xs[p]) and (st.nudge == 0)
            case Cube
                assert (st.x == product) and (st.y == ys[p]) and (st.c == cs[p])
                assert (st.a == ys[p]) and (st.b == xs[p])
            case TimesBase
                assert (st.x == product) and (st.y == ys[p]) and (st.c == cs[p])
                assert st.phase == Shared(cs[p])
            case Start
                assert (st.y == ys[p]) and (st.c == cs[p])
                assert st.x == start_accumulator(f, st.value, st.phase)
                if st.a.length > 0
                    assert st.x == product
            case Tidy
                assert (st.x == tidy(f, xs[p])) and (st.y == ys[p]) and (st.c == cs[p])
            case Clear
                assert (st.y == empty_register(f)) and (st.x == xs[p]) and (st.c == cs[p])
            case Call
                assert (st.x == xs[p]) and (st.c == cs[p])
                for h = 0 to f.n - 1
                    if h != st.hole
                        assert st.y[h] == ys[p][h]
            case Check
                assert (st.c == product) and (st.a == ys[p]) and (st.b == ys[p])
                assert (st.x == xs[p]) and (st.y == ys[p])
            case CheckTidy
                assert (st.c == tidy(f, cs[p])) and (st.x == xs[p]) and (st.y == ys[p])
        x = xs[p]
        y = ys[p]
        c = cs[p]
        s = filled(2 * f.n + 2, 0)
        moves = step_moves(f, xs[p], ys[p], cs[p], st)
        for k = 0 to moves.length - 1
            apply_move(x, y, c, s, moves[k])
        assert (x == st.x) and (y == st.y) and (c == st.c) and is_empty(s)
        xs[p] = st.x
        ys[p] = st.y
        cs[p] = st.c

// The last tidy of `player`'s walks before step `upto`: its X.
func walk_end(steps: List<TraceStep>, player: int, upto: int) -> List<int>
    out: List<int> = []
    for i = 0 to upto - 1
        st = steps[i]
        if (st.player == player) and (st.op == Tidy)
            out = st.x
    return out

// The trace of two built keys is exchange's outcome, step by step: each public walk
// ends in exchange's public value, each shared walk in its K.
func check_trace_exchange(f: Field, dice_a: Dice, dice_b: Dice)
    grid_a = check_trace_build(dice_a)
    grid_b = check_trace_build(dice_b)
    tr = trace_exchange(f, dice_a, dice_b)
    assert (tr.grid_a == grid_a) and (tr.grid_b == grid_b)
    assert (tr.cells_a == read_key([grid_a])) and (tr.cells_b == read_key([grid_b]))
    assert tr.holes_a.length == tr.cells_a.length
    assert tr.holes_b.length == tr.cells_b.length
    check_trace_steps(f, tr.steps)
    assert tr.ok
    first_call = tr.steps.length
    for i = tr.steps.length - 1 downto 0
        if tr.steps[i].op == Clear
            first_call = i
    assert walk_end(tr.steps, 0, first_call) == tr.public_a
    assert walk_end(tr.steps, 1, first_call) == tr.public_b
    assert walk_end(tr.steps, 0, tr.steps.length) == tr.secret_a
    assert walk_end(tr.steps, 1, tr.steps.length) == tr.secret_b

test "trace twins: drop, lay, pay_toll, multiply and tidy record what they change"
    moves: List<PegMove> = []
    s = [2, 2, 0]
    trace_drop(s, 0, 1, moves)
    assert s == [0, 0, 1]
    assert moves == [PegMove(Strip, 0, 2, 0, Drop), PegMove(Strip, 1, 2, 0, Carry), PegMove(Strip, 2, 0, 1, Carry)]
    red = filled(t1.n, 2)
    m: List<PegMove> = []
    assert trace_multiply(t1, red, red, 2, m) == multiply(t1, red, red, 2)
    x = empty_register(t1)
    x[0] = 1
    x[1] = 1
    m = []
    assert trace_multiply(t1, x, x, 0, m) == multiply(t1, x, x, 0)
    // p tidies to the empty register: copy, pour, spill, slide (nothing slides back).
    p = filled(t1.n, 2)
    p[2] = 1
    want = tidy(t1, p)
    m = []
    trace_tidy(t1, X, p, m)
    assert p == want
    assert is_empty(p)
    assert m[m.length - 1].why == Lift

test "trace_build: BUILD hole by hole gives build_key_grid's grid, its dice and its moves"
    g = check_trace_build(dice([1, 5] + filled(96, 1), [1], [6, 2] + filled(48, 5)))
    assert g.ships == [Ship(Destroyer, false, 0, 1, false)]
    g = check_trace_build(dice(filled(99, 1), [], filled(50, 5)))
    assert g.ships.length == 0
    reads: List<BuildRead> = []
    // A ship that grows to a 3-holer and picks a Cruiser: Destroyer, Sub, Cruiser pieces.
    g = trace_build(dice([12] + filled(99, 1), [5, 1, 6], filled(50, 5)), reads)
    assert reads[0].moves[5] == HoleDie(12)
    assert reads[0].moves[6] == Piece(Ship(Destroyer, true, 0, 0, true), [0, 10])
    assert reads[0].moves[7] == Grow(5)
    assert reads[0].moves[8] == Piece(Ship(Sub, true, 0, 0, true), [0, 10, 20])
    assert reads[0].moves[9] == Grow(1)
    assert reads[0].moves[10] == Pick(6)
    assert reads[0].moves[11] == Piece(Ship(Cruiser, true, 0, 0, true), [0, 10, 20])
    assert reads[0].covered == [0, 10, 20]
    assert g.ships == [Ship(Cruiser, true, 0, 0, true)]

test "cell_holes: one hole per cell of read_key, the extra cell at the 3-holer's last hole"
    g = sample_grid_a
    holes = cell_holes(g)
    cells = read_key([g])
    assert holes.length == cells.length
    assert holes[0] == -1
    // Row A of sample_grid_a: Cruiser across A1-A3 (extra cell at A3), Sub down from A5.
    assert (holes[1] == 0) and (holes[3] == 2) and (holes[4] == 2) and (holes[5] == 3)
    assert holes[holes.length - 1] == 199
    assert cell_holes(sample_grid_b).length == read_key([sample_grid_b]).length
    // The peg pass: each cell is the peg in its hole.
    for i = 1 to cells.length - 1
        if holes[i] >= 100
            assert cells[i] == g.pegs[holes[i] - 100]
    // The ship pass: a ship's first hole white across, red down; its last hole white
    // pointing back, red pointing on; a Sub's extra cell plain, a Cruiser's white; every
    // other hole plain.
    first = filled(100, -1)
    last = filled(100, -1)
    extra = filled(100, -1)
    for k = 0 to g.ships.length - 1
        s = g.ships[k]
        under = ship_holes(s)
        first[under[0]] = 1
        if s.down
            first[under[0]] = 2
        last[under[under.length - 1]] = 1
        if s.bow_last
            last[under[under.length - 1]] = 2
        match s.kind
            case Sub
                extra[under[under.length - 1]] = 0
            case Cruiser
                extra[under[under.length - 1]] = 1
            case _
                skip
    for i = 1 to cells.length - 1
        h = holes[i]
        if h < 100
            if first[h] >= 0
                assert cells[i] == first[h]
            else if last[h] >= 0
                if holes[i - 1] == h
                    assert cells[i] == extra[h]
                else
                    assert cells[i] == last[h]
            else
                assert cells[i] == 0

test "trace_steps matches exchange on the sample grids, step by step"
    steps = trace_steps(t1, sample_grid_a, sample_grid_b)
    check_trace_steps(t1, steps)
    e = exchange(t1, [sample_grid_a], [sample_grid_b]).unwrap()
    assert walk_end(steps, 0, steps.length) == e.secret_a
    assert walk_end(steps, 1, steps.length) == e.secret_b

test "trace_exchange matches build_key_grid and exchange on the T1 exchange vectors"
    check_trace_exchange(t1, dice_exchange_t1_run0_a(), dice_exchange_t1_run0_b())
    check_trace_exchange(t1, dice_exchange_t1_run3_a(), dice_exchange_t1_run3_b())

test "trace_exchange matches build_key_grid and exchange on the T2 exchange vector"
    check_trace_exchange(t2, dice_exchange_t2_run3_a(), dice_exchange_t2_run3_b())

test "trace_exchange matches build_key_grid and exchange on the T6 exchange vector"
    check_trace_exchange(t6, dice_exchange_t6_run0_a(), dice_exchange_t6_run0_b())
