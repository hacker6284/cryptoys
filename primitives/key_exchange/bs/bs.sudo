            5, 7, 1, 11, 4, 4, 1, 10, 5, 2, 5, 6, 7, 8, 11, 9, 12, 7, 7, 7, 10, 2, 1, 6, 7,
            2, 2, 2, 4, 10, 8, 10],
        [2, 4, 6, 5, 3, 6, 6, 1, 1, 1, 1, 2, 3, 1, 1, 3, 3, 1, 1, 6, 2, 6, 3, 1, 2, 5, 2,
            4, 2, 2, 6, 4, 1, 4, 2, 1, 6, 5, 3, 2, 4, 5],
        [7, 8, 7, 7, 8, 9, 6, 7, 9, 2, 7, 5, 7, 9, 3, 7, 4, 6, 8, 1, 1, 9, 1, 6, 1, 7, 6,
            6, 6, 1, 1, 2, 3, 1, 0, 0, 7, 4, 9, 4, 0, 3, 2, 2, 3, 7, 4, 0, 9, 9, 3, 0, 9,
            5, 5])

