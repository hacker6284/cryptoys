theorem demo_field_00 (c d e f g_ : Nat)
    (hc : c ≤ 2) (hd : d ≤ 2) (he : e ≤ 2) (hf : f ≤ 2) (hg : g_ ≤ 2) (hne : [0, 0, c, d, e, f, g_] ≠ zeroHome 7) :
    fieldInv 7 5 20 [0, 0, c, d, e, f, g_] ≠ none := by
  rcases (show c = 0 ∨ c = 1 ∨ c = 2 by omega) with rfl | rfl | rfl
  <;> rcases (show d = 0 ∨ d = 1 ∨ d = 2 by omega) with rfl | rfl | rfl
  <;> rcases (show e = 0 ∨ e = 1 ∨ e = 2 by omega) with rfl | rfl | rfl
  <;> rcases (show f = 0 ∨ f = 1 ∨ f = 2 by omega) with rfl | rfl | rfl
  <;> rcases (show g_ = 0 ∨ g_ = 1 ∨ g_ = 2 by omega) with rfl | rfl | rfl
  · have : [0, 0, 0, 0, 0, 0, 0] = zeroHome 7 := by
      simp [zeroHome, zeroPeg, List.replicate]
    exact absurd this hne
