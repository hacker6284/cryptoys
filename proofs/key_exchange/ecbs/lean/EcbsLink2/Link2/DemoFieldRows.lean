theorem demoBandX (k j : Nat) (hk : k < 243) (hj : j < 9) :
    ((demoBand k)[j]'(by rw [demoBandLen k hk]; exact hj)).x =
      expected (9 * k + j) := by
  by_cases h1 : k < 81
  · have hx := demoBandXA k j h1 hj
    simpa [demoBand, h1] using hx
  · by_cases h2 : k < 162
    · have hk2 : k - 81 < 81 := by omega
      have hx := demoBandXB (k - 81) j hk2 hj
      have hshift : 9 * (81 + (k - 81)) + j = 9 * k + j := by omega
      simpa [demoBand, h1, h2, hshift] using hx
    · have hk3 : k - 162 < 81 := by omega
      have hx := demoBandXC (k - 162) j hk3 hj
      have hshift : 9 * (162 + (k - 162)) + j = 9 * k + j := by omega
      simpa [demoBand, h1, h2, hshift] using hx

