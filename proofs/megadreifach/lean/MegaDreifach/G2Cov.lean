/-- Entry `off + i` of a table packed `w` bits per entry, reduced mod `n`. -/
def nd (tab w off n : Nat) (hn : 0 < n) (i : Nat) : Fin n :=
  ⟨Nat.land (Nat.shiftRight tab (w * (off + i))) (2 ^ w - 1) % n, Nat.mod_lt _ hn⟩

/-- Row `k` of four packed cubie tables, as a position. -/
def posN (cp co ep eo : Nat) (k : Nat) : Position where
  cp := fun s => nd cp 5 (20 * k) 20 (by decide) s.val
  co := fun s => nd co 2 (20 * k) 3 (by decide) s.val
  ep := fun s => nd ep 5 (30 * k) 30 (by decide) s.val
  eo := fun s => nd eo 1 (30 * k) 2 (by decide) s.val

/-- Face move `f` from the packed copy of the `ft*` tables. -/
def fmN (f : Nat) : Position := posN ftCpN ftCoN ftEpN ftEoN f

/-- Rotation `s` from the packed copy of `rots`. -/
def rotN (s : Nat) : Grip := fun h => nd rotsN 4 (12 * s) 12 (by decide) h.val

/-- Position equality as a Boolean. -/
def posEqN (p q : Position) : Bool :=
  allF 20 (fun i => Nat.beq (p.cp i).val (q.cp i).val && Nat.beq (p.co i).val (q.co i).val) &&
  allF 30 (fun i => Nat.beq (p.ep i).val (q.ep i).val && Nat.beq (p.eo i).val (q.eo i).val)

theorem posEqN_spec {p q : Position} (h : posEqN p q = true) : p = q := by
  unfold posEqN at h
  simp only [Bool.and_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  have hc := fun i => allF_spec h1 i
  have he := fun i => allF_spec h2 i
  simp only [Bool.and_eq_true] at hc he
  apply Position.ext
  · funext i; exact Fin.ext (Nat.eq_of_beq_eq_true (hc i).1)
  · funext i; exact Fin.ext (Nat.eq_of_beq_eq_true (hc i).2)
  · funext i; exact Fin.ext (Nat.eq_of_beq_eq_true (he i).1)
  · funext i; exact Fin.ext (Nat.eq_of_beq_eq_true (he i).2)

/-- Grip equality as a Boolean. -/
def gripEqN (a b : Grip) : Bool := allF 12 (fun h => Nat.beq (a h).val (b h).val)

theorem gripEqN_spec {a b : Grip} (h : gripEqN a b = true) : a = b :=
  funext fun i => Fin.ext (Nat.eq_of_beq_eq_true (allF_spec h i))

theorem fmN_table : allF 12 (fun f => posEqN (faceMove f) (fmN f.val)) = true := by decide!

theorem faceMove_eq_fmN (f : Fin 12) : faceMove f = fmN f.val := posEqN_spec (allF_spec fmN_table f)

theorem rotN_table : allN 60 (fun s => gripEqN (rotAt s) (rotN s)) = true := by decide!

theorem rotAt_eq_rotN (s : Nat) (hs : s < 60) : rotAt s = rotN s :=
  gripEqN_spec (allN_spec rotN_table s hs)

/-! ## Rotations acting on positions -/

def rhoA (s : Nat) : Position := posN rotCpAN rotCoAN rotEpAN rotEoAN s
def rhoB (s : Nat) : Position := posN rotCpBN rotCoBN rotEpBN rotEoBN s

/-- Conjugation by the whole-puzzle rotation `s < 60`: `rhoA s · g · rhoB s`, which
    moves each cubie to the slot on the rotated faces. -/
def conj (s : Nat) (g : Position) : Position := compose (compose (rhoA s) g) (rhoB s)

/-- The rotation `s` applied to a grip (relabel the physical faces). -/
def rotG (s : Nat) (o : Grip) : Grip := fun h => rotAt s (o h)

theorem rho_inv_table :
    allN 60 (fun s => posEqN (compose (rhoA s) (rhoB s)) identity &&
      posEqN (compose (rhoB s) (rhoA s)) identity) = true := by decide!

theorem rhoAB (s : Nat) (hs : s < 60) : compose (rhoA s) (rhoB s) = identity := by
  have := allN_spec rho_inv_table s hs
  simp only [Bool.and_eq_true] at this
  exact posEqN_spec this.1

theorem rhoBA (s : Nat) (hs : s < 60) : compose (rhoB s) (rhoA s) = identity := by
  have := allN_spec rho_inv_table s hs
  simp only [Bool.and_eq_true] at this
  exact posEqN_spec this.2

theorem conj_compose (s : Nat) (hs : s < 60) (g h : Position) :
    conj s (compose g h) = compose (conj s g) (conj s h) := by
  unfold conj
  simp only [compose_assoc]
  rw [← compose_assoc (rhoB s) (rhoA s), rhoBA s hs, compose_id_left]

theorem conj_identity (s : Nat) (hs : s < 60) : conj s identity = identity := by
  unfold conj; rw [compose_id_right, rhoAB s hs]

theorem fm_cov_table :
    allN 60 (fun s => allF 12 (fun f => posEqN (conj s (fmN f.val)) (fmN (rotN s f).val))) = true := by
  decide!

theorem faceMove_cov (s : Nat) (hs : s < 60) (f : Fin 12) :
    conj s (faceMove f) = faceMove (rotAt s f) := by
  rw [faceMove_eq_fmN, faceMove_eq_fmN, rotAt_eq_rotN s hs]
  exact posEqN_spec (allF_spec (allN_spec fm_cov_table s hs) f)

/-! ## Face turns, visual noon and spin -/

theorem leftIter_cov (s : Nat) (hs : s < 60) (f : Fin 12) :
    ∀ (n : Nat) (g : Position), conj s (leftIter (faceMove f) n g) =
      leftIter (faceMove (rotAt s f)) n (conj s g)
  | 0, _ => rfl
  | n + 1, g => by
      simp only [leftIter]
      rw [conj_compose s hs, faceMove_cov s hs, leftIter_cov s hs f n g]

theorem faceTurn_cov (s : Nat) (hs : s < 60) (g : Position) (f : Fin 12) (n : Nat) :
    conj s (faceTurn g f n) = faceTurn (conj s g) (rotAt s f) n :=
  leftIter_cov s hs f _ g

theorem visualNoon_cov (s : Nat) (p : Fin 12) (o : Grip) :
    visualNoon p (rotG s o) = rotAt s (visualNoon p o) := by
  unfold visualNoon rotG
  split
  · rfl
  · split
    · rfl
    · split <;> rfl

theorem spin_cov_table :
    allN 60 (fun s => allF 12 (fun up => allF 12 (fun x => allN 4 (fun k =>
      Nat.beq (spinPhys (rotN s up) (k + 1) (rotN s x)).val
        (rotN s (spinPhys up (k + 1) x)).val)))) = true := by
  decide!

theorem spinPhys_cov (s : Nat) (hs : s < 60) (up x : Fin 12) (k : Nat) (hk1 : 0 < k) (hk : k < 5) :
    spinPhys (rotAt s up) k (rotAt s x) = rotAt s (spinPhys up k x) := by
  rw [rotAt_eq_rotN s hs]
  have := allN_spec (allF_spec (allF_spec (allN_spec spin_cov_table s hs) up) x) (k - 1) (by omega)
  rw [show k - 1 + 1 = k by omega] at this
  exact Fin.ext (Nat.eq_of_beq_eq_true this)

theorem spinAboutUp_cov (s : Nat) (hs : s < 60) (o : Grip) (k : Nat) :
    spinAboutUp (rotG s o) k = rotG s (spinAboutUp o k) := by
  unfold spinAboutUp
  by_cases h : k % 5 = 0
  · simp only [h, if_true]
  · simp only [h, if_false]
    funext i
    exact spinPhys_cov s hs (o 0) (o i) (k % 5) (by omega) (Nat.mod_lt _ (by decide))

/-! ## Rotations of grips -/

theorem lt_of_blt {a b : Nat} (h : Nat.blt a b = true) : a < b := Nat.le_of_ble_eq_true h

theorem rotMul_table :
    allN 60 (fun s => allN 60 (fun t =>
      Nat.blt (nd rotMulN 6 (60 * s) 64 (by decide) t).val 60 &&
      gripEqN (fun h => rotN s (rotN t h)) (rotN (nd rotMulN 6 (60 * s) 64 (by decide) t).val))) = true := by
  decide!

theorem rotG_rotAt (s : Nat) (hs : s < 60) (t : Nat) (ht : t < 60) :
    ∃ u, u < 60 ∧ rotG s (rotAt t) = rotAt u := by
  have := allN_spec (allN_spec rotMul_table s hs) t ht
  simp only [Bool.and_eq_true] at this
  refine ⟨_, lt_of_blt this.1, ?_⟩
  rw [rotAt_eq_rotN _ (lt_of_blt this.1)]
  unfold rotG
  rw [rotAt_eq_rotN s hs, rotAt_eq_rotN t ht]
  exact gripEqN_spec this.2

theorem gripOk_rotG (s : Nat) (hs : s < 60) (o : Grip) (ho : GripOk o) : GripOk (rotG s o) := by
  obtain ⟨t, ht, rfl⟩ := ho
  obtain ⟨u, hu, he⟩ := rotG_rotAt s hs t ht
  exact ⟨u, hu, he⟩

theorem rot_unique_table :
    allN 60 (fun t => allN 60 (fun u =>
      !(Nat.beq (rotN t 0).val (rotN u 0).val && Nat.beq (rotN t 1).val (rotN u 1).val) ||
        Nat.beq t u)) = true := by
  decide!

theorem rotAt_unique (t u : Nat) (ht : t < 60) (hu : u < 60) (h0 : rotAt t 0 = rotAt u 0)
    (h1 : rotAt t 1 = rotAt u 1) : t = u := by
  have := allN_spec (allN_spec rot_unique_table t ht) u hu
  rw [rotAt_eq_rotN t ht, rotAt_eq_rotN u hu] at h0 h1
  simp only [h0, h1, Nat.beq_refl, Bool.and_self, Bool.not_true, Bool.false_or] at this
  exact Nat.eq_of_beq_eq_true this

theorem rot_inj_table :
    allN 60 (fun s => allF 12 (fun a => allF 12 (fun b =>
      !Nat.beq (rotN s a).val (rotN s b).val || Nat.beq a.val b.val))) = true := by
  decide!

theorem rotAt_inj (s : Nat) (hs : s < 60) {a b : Fin 12} (h : rotAt s a = rotAt s b) : a = b := by
  have := allF_spec (allF_spec (allN_spec rot_inj_table s hs) a) b
  rw [rotAt_eq_rotN s hs] at h
  simp only [h, Nat.beq_refl, Bool.not_true, Bool.false_or] at this
  exact Fin.ext (Nat.eq_of_beq_eq_true this)

theorem rotG_inj (s : Nat) (hs : s < 60) {o o' : Grip} (h : rotG s o = rotG s o') : o = o' :=
  funext fun i => rotAt_inj s hs (congrFun h i)

theorem absReorient_eq_of (c1 c2 : Fin 12) (u : Nat) (hu : u < 60) (h0 : rotAt u 0 = c1)
    (h1 : rotAt u 1 = c2) : absReorient c1 c2 = rotAt u := by
  have hsome : ((List.range 60).find? (fun s => decide (rotAt s 0 = c1 ∧ rotAt s 1 = c2))).isSome := by
    rw [List.find?_isSome]
    exact ⟨u, List.mem_range.mpr hu, by simp [h0, h1]⟩
  obtain ⟨t, ht⟩ := Option.isSome_iff_exists.mp hsome
  have hmem := List.mem_range.mp (List.mem_of_find?_eq_some ht)
  have hp := List.find?_some ht
  simp only [decide_eq_true_eq] at hp
  have : t = u := rotAt_unique t u hmem hu (hp.1.trans h0.symm) (hp.2.trans h1.symm)
  subst this
  unfold absReorient absReorient?
  rw [ht]
  rfl

theorem absReorient_cov (s : Nat) (hs : s < 60) (c1 c2 : Fin 12) (h : c2 ∈ nbrs c1) :
    absReorient (rotAt s c1) (rotAt s c2) = rotG s (absReorient c1 c2) := by
  have hs' : (absReorient? c1 c2).isSome := by rw [absReorient?_some_iff]; exact decide_eq_true h
  obtain ⟨r, hr⟩ := Option.isSome_iff_exists.mp hs'
  obtain ⟨⟨t, ht, rfl⟩, h0, h1⟩ := absReorient?_spec c1 c2 r hr
  have hA : absReorient c1 c2 = rotAt t := by unfold absReorient; rw [hr]; rfl
  rw [hA]
  obtain ⟨u, hu, he⟩ := rotG_rotAt s hs t ht
  rw [he]
  apply absReorient_eq_of _ _ u hu
  · rw [← he]; unfold rotG; rw [h0]
  · rw [← he]; unfold rotG; rw [h1]

