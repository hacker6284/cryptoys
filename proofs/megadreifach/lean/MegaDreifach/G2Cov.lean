/-
  Rotation covariance of the v2 card step, part 1: the finite tables and the
  step-level lemmas.

  The 60 whole-puzzle rotations `rotAt s` act on positions by conjugation,
  `conj s g = rhoA s ∘ g ∘ rhoB s` (`rhoA s` / `rhoB s` relabel the cubie slots and
  shift corner orientations; they are mutually inverse, `rhoAB`, `rhoBA`), and on
  grips by relabelling the physical faces, `rotG s o = rotAt s ∘ o`.  This file
  proves, from packed copies of the SPEC tables (`*N`, checked against `Em` by kernel
  `decide!`):

  * `faceMove_cov` / `faceTurn_cov`: conjugating a face turn by rotation `s` gives
    the turn of the rotated face;
  * `visualNoon_cov`, `spinAboutUp_cov`, `absReorient_cov`: the grip-side helpers
    commute with the rotation;
  * `gripOk_rotG`, `rotAt_inj`, `rotG_inj`: rotated `GripOk` grips stay `GripOk`,
    and the action is injective.

  The read lemmas and `g2Step_cov` / `net2_cov` are in `G2CovRead.lean`; M9 uses them
  (`M9.lean`).  Kernel `decide!` on finite tables only (about 76 s).  Zero sorry,
  no native_decide.
-/
import MegaDreifach.G2Nets

namespace MegaDreifach.G2Cov

open MegaDreifach MegaDreifach.Em MegaDreifach.Link2

/-! ## Finite checks as Booleans -/

/-- `∀ i < n, p i` as a Boolean (kernel-friendly recursion on `n`). -/
def allN : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | n + 1, p => p n && allN n p

theorem allN_spec : ∀ {n : Nat} {p : Nat → Bool}, allN n p = true → ∀ i, i < n → p i = true
  | 0, _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | n + 1, p, h, i, hi => by
      simp only [allN, Bool.and_eq_true] at h
      rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hi) with hi | rfl
      · exact allN_spec h.2 i hi
      · exact h.1

/-- `∀ i : Fin n, p i` as a Boolean. -/
def allF (n : Nat) (p : Fin n → Bool) : Bool := allN n (fun i => if h : i < n then p ⟨i, h⟩ else true)

theorem allF_spec {n : Nat} {p : Fin n → Bool} (h : allF n p = true) (i : Fin n) : p i = true := by
  have := allN_spec h i.val i.isLt
  simpa [i.isLt] using this

